---
// A floating, button-triggered "On this page" overlay that replaces Starlight's
// right-hand TOC column. Built from Starlight's own `toc` data so anchors and the
// localized label stay correct. Works at every breakpoint.
interface TocItem {
  depth: number;
  slug: string;
  text: string;
  children: TocItem[];
}

interface Props {
  toc: { items: TocItem[]; minHeadingLevel: number; maxHeadingLevel: number };
}

const { toc } = Astro.props;
const label = Astro.locals.t('tableOfContents.onThisPage');

// Flatten the nested TOC, keeping each item's heading depth for indentation.
function flatten(items: TocItem[]): TocItem[] {
  return items.flatMap((item) => [item, ...flatten(item.children ?? [])]);
}
const entries = flatten(toc.items);
const baseDepth = toc.minHeadingLevel;
---

<floating-toc class="ftoc">
  <button
    type="button"
    class="ftoc__toggle"
    aria-expanded="false"
    aria-controls="ftoc-panel"
    aria-label={label}
  >
    <svg
      class="ftoc__icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="8" y1="6" x2="21" y2="6"></line>
      <line x1="8" y1="12" x2="21" y2="12"></line>
      <line x1="8" y1="18" x2="21" y2="18"></line>
      <line x1="3" y1="6" x2="3.01" y2="6"></line>
      <line x1="3" y1="12" x2="3.01" y2="12"></line>
      <line x1="3" y1="18" x2="3.01" y2="18"></line>
    </svg>
    <span class="ftoc__label">{label}</span>
  </button>

  <div class="ftoc__panel" id="ftoc-panel" hidden>
    <p class="ftoc__heading">{label}</p>
    <nav>
      <ul>
        {
          entries.map((entry) => (
            <li style={`--depth:${Math.max(0, entry.depth - baseDepth)}`}>
              <a href={`#${entry.slug}`} data-ftoc-link>
                {entry.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</floating-toc>

<style>
  @layer starlight.core {
    .ftoc {
      --ftoc-offset: 1.5rem;
    }

    .ftoc__toggle {
      position: fixed;
      inset-block-end: var(--ftoc-offset);
      inset-inline-end: var(--ftoc-offset);
      z-index: var(--sl-z-index-toc, 7);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.625rem 0.9rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 999px;
      background-color: var(--sl-color-black);
      color: var(--sl-color-white);
      font-size: var(--sl-text-xs);
      line-height: 1;
      box-shadow: var(--sl-shadow-md);
      cursor: pointer;
      transition:
        border-color var(--sl-menu-transition, 0.15s) ease,
        background-color 0.15s ease,
        transform 0.15s ease;
    }
    .ftoc__toggle:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-white);
    }
    .ftoc__toggle:focus-visible {
      outline: 2px solid var(--sl-color-accent-high);
      outline-offset: 2px;
    }
    .ftoc[data-open] .ftoc__toggle {
      border-color: var(--sl-color-accent);
    }

    .ftoc__icon {
      flex-shrink: 0;
    }

    .ftoc__panel {
      position: fixed;
      inset-block-end: calc(var(--ftoc-offset) + 3rem);
      inset-inline-end: var(--ftoc-offset);
      z-index: var(--sl-z-index-toc, 7);
      width: min(22rem, calc(100vw - 2 * var(--ftoc-offset)));
      max-height: min(60vh, 32rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 1rem 1.25rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.75rem;
      background-color: color-mix(in srgb, var(--sl-color-bg-nav) 92%, transparent);
      backdrop-filter: blur(8px);
      box-shadow: var(--sl-shadow-lg, var(--sl-shadow-md));
    }
    .ftoc__panel[hidden] {
      display: none;
    }

    .ftoc__heading {
      margin: 0 0 0.5rem;
      color: var(--sl-color-white);
      font-size: var(--sl-text-h5);
      font-weight: 600;
      line-height: var(--sl-line-height-headings);
    }

    .ftoc__panel ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .ftoc__panel li {
      padding-inline-start: calc(var(--depth, 0) * 1rem);
    }
    .ftoc__panel a {
      display: block;
      padding: 0.3rem 0;
      font-size: var(--sl-text-xs);
      text-decoration: none;
      color: var(--sl-color-gray-3);
      overflow-wrap: anywhere;
      border-inline-start: 2px solid transparent;
      transition: color 0.12s ease;
    }
    .ftoc__panel a:hover {
      color: var(--sl-color-white);
    }
    .ftoc__panel a[aria-current='true'] {
      color: var(--sl-color-text-accent);
      font-weight: 600;
    }

    @media (prefers-reduced-motion: reduce) {
      .ftoc__toggle {
        transition: none;
      }
    }
  }
</style>

<script>
  class FloatingToc extends HTMLElement {
    connectedCallback() {
      const toggle = this.querySelector<HTMLButtonElement>('.ftoc__toggle');
      const panel = this.querySelector<HTMLDivElement>('.ftoc__panel');
      const links = Array.from(
        this.querySelectorAll<HTMLAnchorElement>('[data-ftoc-link]')
      );
      if (!toggle || !panel) return;

      const setOpen = (open: boolean) => {
        panel.hidden = !open;
        toggle.setAttribute('aria-expanded', String(open));
        this.toggleAttribute('data-open', open);
      };

      toggle.addEventListener('click', () => setOpen(panel.hidden));

      // Close on link click, outside click, or Escape.
      links.forEach((link) =>
        link.addEventListener('click', () => setOpen(false))
      );
      document.addEventListener('click', (event) => {
        if (!panel.hidden && !this.contains(event.target as Node)) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !panel.hidden) {
          setOpen(false);
          toggle.focus();
        }
      });

      // Scroll-spy: highlight the heading currently in view.
      const byId = new Map<string, HTMLAnchorElement>();
      links.forEach((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        if (id) byId.set(id, link);
      });
      const headings = Array.from(byId.keys())
        .map((id) => document.getElementById(id))
        .filter((el): el is HTMLElement => el !== null);

      let current: HTMLAnchorElement | null = null;
      const markCurrent = (id: string) => {
        const link = byId.get(id);
        if (!link || link === current) return;
        current?.removeAttribute('aria-current');
        link.setAttribute('aria-current', 'true');
        current = link;
      };

      const observer = new IntersectionObserver(
        (records) => {
          const visible = records
            .filter((r) => r.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          if (visible?.target.id) markCurrent(visible.target.id);
        },
        { rootMargin: '0px 0px -66% 0px', threshold: 0 }
      );
      headings.forEach((heading) => observer.observe(heading));
    }
  }

  if (!customElements.get('floating-toc')) {
    customElements.define('floating-toc', FloatingToc);
  }
</script>
